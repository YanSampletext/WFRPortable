# Скопируй в android/keystore.properties и подставь свои значения.
# Файл с настоящими паролями в git не попадает (см. .gitignore).
#
# storeFile — путь к тому же keystore, которым подписывалась TWA-сборка
# (twa-project/android.keystore). Тот же ключ = приложение встанет
# обновлением поверх установленного, а не потребует удаления.
# Путь считается от папки android/, можно указать абсолютный.
storeFile=../twa-project/android.keystore
storePassword=wfrp4-signing-pass
keyAlias=android
keyPassword=wfrp4-signing-pass
