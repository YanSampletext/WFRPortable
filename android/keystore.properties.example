# Скопируй в android/keystore.properties и подставь свои значения.
# Файл с настоящими паролями в git не попадает (см. .gitignore).
#
# storeFile — путь к ключу подписи. Считается от папки android/,
# можно указать и абсолютный. Обновлять установленное приложение
# получится только APK, подписанным тем же ключом.
storeFile=../wfrp4.keystore
storePassword=wfrp4-signing-pass
keyAlias=android
keyPassword=wfrp4-signing-pass
